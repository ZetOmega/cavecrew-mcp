# Dist folder
dist/

# Node.js dependencies
node_modules/

# Log files
logs/
*.log
npm-debug.log*

# Process IDs
pids/
*.pid
*.seed
*.pid.lock

# Per-bot death ledgers (cave/deaths/<name>.json)
deaths/

# Per-bot machine-readable DEPOT ledgers (cave/ledger/<name>.jsonl) —
# runtime-generated, per-machine, same as logs/pids/deaths above.
ledger/

# Per-bot mission history (cave/missions/<name>.jsonl) — same reasoning.
missions/

# Audit tool's last-run chest snapshot (cave/audit.mjs) — machine/session
# local runtime state, not a durable record; the diff it prints/logs each
# run is the thing worth keeping, not the raw snapshot itself.
audit-snapshot.json

# NPM cache
.npm/

# REPL history
.node_repl_history

# Claude Code configuration
.claude
.idea
