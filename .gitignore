# Dist folder
dist/

# Node.js dependencies
node_modules/

# Log files
logs/
*.log
npm-debug.log*

# Process IDs
pids/
*.pid
*.seed
*.pid.lock

# Per-bot death ledgers (cave/deaths/<name>.json)
deaths/

# Audit tool's last-run chest snapshot (cave/audit.mjs) — machine/session
